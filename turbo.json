{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@regan-ad/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/docs-dist/**"]
    },
    "docs:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "$TURBO_ROOT$/docs-dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
