{
  "name": "regan-ad-monorepo",
  "version": "1.0.0",
  "description": "Regan AD 组件库 Monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "buildsub": "turbo run build --filter @regan-ad/base-ui",
    "build": "turbo run build",
    "docs:dev": "pnpm --filter @regan-ad/docs dev",
    "docs:build": "turbo run build --filter @regan-ad/docs",
    "lint": "turbo run lint",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "turbo": "^2.9.16",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
