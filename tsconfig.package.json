{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2018",
    "lib": ["DOM", "DOM.Iterable", "ES2018"],
    "skipLibCheck": true,
    "strict": true
  }
}
