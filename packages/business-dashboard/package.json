{
  "name": "@regan-ad/business-dashboard",
  "version": "1.0.0",
  "description": "数据大屏业务组件库",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.less",
    "*.scss"
  ],
  "files": ["dist"],
  "scripts": {
